if(NOT DEFINED REV5_ROOT)
    get_filename_component(REV5_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()

function(require_frozen_source relative_path expected_sha256)
    set(source_path "${REV5_ROOT}/${relative_path}")
    if(NOT EXISTS "${source_path}" OR IS_SYMLINK "${source_path}")
        message(FATAL_ERROR "Missing or symlinked frozen source: ${relative_path}")
    endif()
    file(SHA256 "${source_path}" actual_sha256)
    if(NOT actual_sha256 STREQUAL expected_sha256)
        message(FATAL_ERROR "Frozen source changed: ${relative_path}; owner rebind required.")
    endif()
endfunction()

